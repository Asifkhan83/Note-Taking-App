# Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file with real credentials to version control

# Database
DATABASE_URL="file:./dev.db"

# Google Gemini API Key (required for AI features)
# Get your API key at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY="your-google-api-key-here"

# Application Security
# Password to access the app - CHANGE THIS to your own secure password
APP_PASSWORD="your-secure-password-here"
# JWT Secret for session encryption - Generate a random string (min 32 characters)
JWT_SECRET="your-random-jwt-secret-min-32-chars-here"
